rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ADMIN: paste Leah's Firebase Auth UID here (Firebase console > Authentication > Users > "User UID").
    // Only accounts listed here can read or manage bookings. Add a second UID later for a team member.
    function isAdmin() {
      return request.auth != null
        && request.auth.uid in ['PASTE_LEAH_UID_HERE'];
    }

    function validDate(d) { return d is string && d.matches('^20[0-9]{2}-[01][0-9]-[0-3][0-9]$'); }
    function validTime(t) { return t is string && t.matches('^[0-2][0-9]:[0-5][0-9]$'); }

    // PUBLIC AVAILABILITY: only date + time, nothing personal (the site reads this to grey out taken times).
    // Create-only, so a slot that exists can never be overwritten: that is what blocks double booking.
    // A slot can only be created together with its booking (same batch), so nobody can block times with empty slots.
    match /slots/{slotId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['date', 'time', 'createdAt'])
                    && validDate(request.resource.data.date)
                    && validTime(request.resource.data.time)
                    && slotId == request.resource.data.date + '_' + request.resource.data.time.replace(':', '')
                    && request.resource.data.createdAt == request.time
                    && existsAfter(/databases/$(database)/documents/bookings/$(slotId));
      allow update: if false;
      allow delete: if isAdmin();   // used when Leah cancels a booking, to free the time
    }

    // BOOKINGS: anyone can create one (together with its slot), only the admin can read or manage them.
    match /bookings/{bookingId} {
      allow create: if request.resource.data.keys().hasOnly(
                          ['service', 'date', 'time', 'name', 'businessName', 'whatsapp', 'instagram',
                           'niche', 'problem', 'status', 'createdAt'])
                    && request.resource.data.service in ['audit', 'strategy', 'setup']
                    && validDate(request.resource.data.date)
                    && validTime(request.resource.data.time)
                    && bookingId == request.resource.data.date + '_' + request.resource.data.time.replace(':', '')
                    && request.resource.data.name is string
                    && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 80
                    && request.resource.data.businessName is string && request.resource.data.businessName.size() <= 80
                    && request.resource.data.whatsapp is string
                    && request.resource.data.whatsapp.matches('^[0-9]{10,15}$')
                    && request.resource.data.instagram is string && request.resource.data.instagram.size() <= 60
                    && request.resource.data.niche is string && request.resource.data.niche.size() <= 60
                    && request.resource.data.problem is string && request.resource.data.problem.size() <= 600
                    && request.resource.data.status == 'new'
                    && request.resource.data.createdAt == request.time
                    && getAfter(/databases/$(database)/documents/slots/$(bookingId)).data.date == request.resource.data.date;

      allow read: if isAdmin();

      // The admin can only change status, notes and the updatedAt stamp, never the customer's own details.
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'notes', 'updatedAt'])
                    && request.resource.data.status in ['new', 'confirmed', 'completed', 'no_show', 'cancelled']
                    && (!('notes' in request.resource.data) || (request.resource.data.notes is string && request.resource.data.notes.size() <= 1000));

      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
